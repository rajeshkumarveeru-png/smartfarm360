# Production settings for deploy/compose.yaml. Copy to deploy/.env, fill in, and make it readable only by the
# service user (chmod 600). Never commit the filled-in file. The app refuses to start when a required value is unsafe.

SMARTFARM_IMAGE=ghcr.io/OWNER/smartfarm360:0.15.0
# production (the default) or staging. Staging must use Razorpay test keys and a host name containing "staging".
APP_ENVIRONMENT=production
DOMAIN=app.example.in
ACME_EMAIL=ops@example.in

# Managed PostgreSQL 18 in an Indian region. The user must NOT be a superuser (Row-Level Security, ADR 0011).
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.internal:5432/smartfarm360?sslmode=require
SPRING_DATASOURCE_USERNAME=smartfarm360
SPRING_DATASOURCE_PASSWORD=

# At least 32 random bytes:  openssl rand -base64 48
APP_JWT_SECRET=
# Exactly 32 random bytes, base64:  openssl rand -base64 32
APP_MFA_ENCRYPTION_KEY=
APP_PUBLIC_WEB_URL=https://app.example.in
APP_CORS_ALLOWED_ORIGINS=https://app.example.in
APP_REFRESH_COOKIE_SECURE=true
APP_API_DOCS_ENABLED=false
APP_MAIL_DEV_LOG_LINKS=false

# SMTP of the transactional email provider chosen with the host (O5)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=SmartFarm360 <no-reply@example.in>
# Operators' address for alerts and test alerts (O4)
APP_OPS_ALERT_EMAIL=ops@example.in

# Oldest phone app version allowed to sync (empty allows all; raise only when an old app cannot sync safely)
APP_MIN_CLIENT_VERSION=

# First start only, to create the first platform administrator; then set back to false (the app refuses true in prod)
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Billing (billing design, Phase 15). prod refuses the fake gateway and Razorpay test keys; staging uses test keys.
APP_BILLING_GATEWAY=razorpay
APP_BILLING_RAZORPAY_KEY_ID=
APP_BILLING_RAZORPAY_KEY_SECRET=
# The secret set on the Razorpay webhook for https://<host>/api/v1/billing/webhooks/razorpay (at least 16 characters)
APP_BILLING_WEBHOOK_SECRET=
# The platform's legal entity, printed on every GST invoice; the GSTIN's first two digits are the seller's state
APP_BILLING_SELLER_NAME=
APP_BILLING_SELLER_GSTIN=
APP_BILLING_SELLER_ADDRESS=
