# SmartFarm360 local configuration (copy values into your environment; never commit real secrets)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartfarm360
SPRING_DATASOURCE_USERNAME=smartfarm360
SPRING_DATASOURCE_PASSWORD=change-me
PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
SMARTFARM_LOG_DIR=logs

# Access-token signing secret, at least 32 random bytes. Required outside throw-away local runs:
# without it a random key is generated at start-up and everyone is signed out on restart.
APP_JWT_SECRET=
# Base URL of the web app, used in password-reset and invitation links
APP_PUBLIC_WEB_URL=http://localhost:5174
# Set to false only if you serve the app over plain HTTP on a non-localhost address (not recommended)
APP_REFRESH_COOKIE_SECURE=true

# No email provider yet. Local development only: write reset/invitation links to the log.
APP_MAIL_DEV_LOG_LINKS=false

# Optional platform administrator created at start-up (no default credentials)
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Disable the OpenAPI UI in production
APP_API_DOCS_ENABLED=true
# Behind a reverse proxy set this to "framework" so rate limits use the real client IP
SERVER_FORWARD_HEADERS_STRATEGY=none

# Optional for mobile development: EXPO_PUBLIC_API_URL=http://192.168.x.x:8080
